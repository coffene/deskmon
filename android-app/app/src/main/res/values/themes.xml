<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.PCResourceMonitor" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/accent_primary</item>
        <item name="colorPrimaryVariant">@color/accent_primary</item>
        <item name="colorOnPrimary">@color/bg_screen</item>
        <item name="colorSecondary">@color/m2_secondary</item>
        <item name="colorOnSecondary">@color/bg_screen</item>
        <item name="colorSurface">@color/bg_card</item>
        <item name="colorOnSurface">@color/m2_on_surface_high</item>
        <item name="android:windowBackground">@color/bg_screen</item>
        <item name="android:colorBackground">@color/bg_card</item>
        <item name="android:textColorPrimary">@color/m2_on_surface_high</item>
        <item name="android:textColorSecondary">@color/m2_on_surface_medium</item>
        <item name="android:textColorHint">@color/m2_on_surface_medium</item>
        <item name="colorControlNormal">@color/m2_on_surface_medium</item>
        <item name="colorControlActivated">@color/m2_secondary</item>
        <item name="android:statusBarColor">@color/bg_screen</item>
        <item name="android:navigationBarColor">@color/bg_screen</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.PCResourceMonitor.Dialog</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.PCResourceMonitor.Dialog</item>
        <item name="fontFamily">@font/font_fira_sans</item>
        <item name="android:fontFamily">@font/font_fira_sans</item>
    </style>

    <style name="ThemeOverlay.PCResourceMonitor.Dialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="colorSurface">@color/bg_card</item>
        <item name="colorOnSurface">@color/m2_on_surface_high</item>
        <item name="colorPrimary">@color/m2_secondary</item>
        <item name="colorSecondary">@color/m2_secondary</item>
        <item name="android:background">@color/bg_card</item>
        <item name="android:colorBackground">@color/bg_card</item>
        <item name="android:textColorPrimary">@color/m2_on_surface_high</item>
        <item name="android:textColorSecondary">@color/m2_on_surface_medium</item>
        <item name="android:textColorHint">@color/m2_on_surface_medium</item>
        <item name="colorControlNormal">@color/m2_on_surface_medium</item>
        <item name="colorControlActivated">@color/m2_secondary</item>
    </style>

    <style name="Theme.PCResourceMonitor.Plex" parent="Theme.PCResourceMonitor">
        <item name="fontFamily">@font/font_ibm_plex_sans</item>
        <item name="android:fontFamily">@font/font_ibm_plex_sans</item>
    </style>

    <style name="Theme.PCResourceMonitor.Barlow" parent="Theme.PCResourceMonitor">
        <item name="fontFamily">@font/font_barlow</item>
        <item name="android:fontFamily">@font/font_barlow</item>
    </style>

    <style name="Theme.PCResourceMonitor.Roboto" parent="Theme.PCResourceMonitor">
        <item name="fontFamily">sans-serif</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="MetricCard" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/bg_card</item>
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/stroke_card</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="ModeToggleButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">34dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingLeft">10dp</item>
        <item name="android:paddingRight">10dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="strokeColor">@color/stroke_card</item>
    </style>

    <style name="TimerPresetButton" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">28dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingLeft">7dp</item>
        <item name="android:paddingRight">7dp</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/m2_on_surface_medium</item>
    </style>
</resources>
